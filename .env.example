# Apenas valores públicos do frontend.
# NUNCA coloque BLING_CLIENT_SECRET, BLING_ACCESS_TOKEN, META_ACCESS_TOKEN,
# OPENAI_API_KEY ou ADMIN_KEY em variáveis VITE_*.

VITE_APP_NAME=CHAT
VITE_APP_ENV=development

# Endpoint que entregue somente os dados permitidos ao Admin.
# Enquanto não configurado, o frontend usa /data/products.json.
VITE_CATALOG_URL=

# Webhook/bridge do Admin no Make.
# ATENÇÃO: qualquer VITE_* fica visível no navegador. Este endpoint só pode ser
# usado se o cenário validar uma ADMIN_KEY enviada na requisição antes de executar ações.
# A ADMIN_KEY nunca entra neste arquivo; o usuário informa a chave por sessão no Admin.
VITE_ADMIN_BRIDGE_URL=

# Variáveis abaixo são SOMENTE para processos server-side/CLI e não usam prefixo VITE_.
# Não preencher este arquivo com valores reais.
BLING_API_BASE=https://api.bling.com.br/Api/v3
BLING_ACCESS_TOKEN=
BLING_PRODUCTS_OUTPUT=runtime/products.json
