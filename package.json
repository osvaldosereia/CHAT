{
  "name": "chat-dona-antonia",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check:server": "node --check server/bling/oauth.mjs && node --check server/bling/client.mjs && node --check scripts/bling/sync-products.mjs",
    "build": "npm run typecheck && npm run check:server && vite build",
    "preview": "vite preview",
    "sync:bling-products": "node scripts/bling/sync-products.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
